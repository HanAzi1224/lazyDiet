{
  "name": "lazydiet-api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "nodemon ./server/app.js",
    "dev": "NODE_ENV=local nodemon ./server/app.js -e ejs,js,json",
    "pm2:dev": "NODE_ENV=local pm2-runtime --json pm2Server.json",
    "pm2:local": "NODE_ENV=local pm2-runtime --json pm2Server.local.json",
    "devtest": "NODE_ENV=local node ./server/app.js -e ejs,js,json",
    "scrapping": "NODE_ENV=local node ./scrapping/news -e ejs,js,json",
    "insertDummies": "node tests/dummies/index.js",
    "push": "bash scripts/push-ecr.sh",
    "lint": "eslint ./server/**/*.js --fix",
    "prettier": "prettier --write .",
    "test-all": "NODE_ENV=local mocha test/**/*.spec.js --exit",
    "test": "NODE_ENV=local jest",
    "hook-setting": "rm -rf .husky/pre-commit .husky/pre-push && npx husky add .husky/pre-commit 'npx lint-staged' && npx husky add .husky/pre-push 'npm run test'",
    "generate": "npx sequelize-cli migration:generate --name",
    "generate:scrapping": "npx sequelize-cli migration:generate --options-path .sequelizerc-scrapping --name",
    "migrate": "NODE_ENV=migration npx sequelize-cli db:migrate",
    "migrate:scrapping": "NODE_ENV=migration npx sequelize-cli db:migrate --options-path .sequelizerc-scrapping",
    "undo": "NODE_ENV=migration npx sequelize-cli db:migrate:undo",
    "undo:scrapping": "NODE_ENV=migration npx sequelize-cli db:migrate:undo --options-path .sequelizerc-scrapping",
    "sync": "NODE_ENV=local node ./server/libs/sync.js"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.spec.js"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.js": [
      "prettier --write",
      "eslint ./server --fix",
      "git add"
    ]
  },
  "dependencies": {
    "adm-zip": "^0.5.10",
    "ajv": "^8.12.0",
    "ajv-errors": "^3.0.0",
    "ajv-i18n": "^4.2.0",
    "aligoapi": "^1.1.3",
    "amqplib": "^0.10.3",
    "app-root-path": "^3.0.0",
    "apple-auth": "^1.0.9",
    "aws-sdk": "^2.1381.0",
    "axios": "^0.21.4",
    "bcrypt-nodejs": "0.0.3",
    "body-parser": "^1.19.0",
    "bwip-js": "^3.4.3",
    "chai-http": "^4.4.0",
    "child_process": "^1.0.2",
    "concurrently": "^6.2.0",
    "cookie-parser": "^1.4.5",
    "cors": "^2.8.5",
    "crypto-js": "^4.0.0",
    "date-fns": "^2.30.0",
    "date-fns-tz": "^2.0.0",
    "debug": "~4.3.2",
    "dotenv": "^10.0.0",
    "ejs": "~3.1.6",
    "express": "^4.21.2",
    "express-basic-auth": "^1.2.0",
    "express-rate-limit": "^5.3.0",
    "firebase": "^10.0.0",
    "firebase-admin": "^11.11.0",
    "fluent-logger": "^3.4.1",
    "fs-extra": "^10.0.0",
    "helmet": "^4.6.0",
    "http-errors": "^1.8.0",
    "iconv-lite": "^0.6.3",
    "jimp": "^0.22.10",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.17.21",
    "log4js": "^6.3.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.2",
    "mysql": "^2.18.1",
    "mysql2": "^3.2.4",
    "nodemon": "^3.0.1",
    "openai": "^3.2.1",
    "puppeteer": "^19.8.0",
    "rate-limit-redis": "^2.1.0",
    "redis": "^3.1.2",
    "s3-streamlogger": "^1.7.0",
    "sequelize": "^6.29.3",
    "sequelize-auto": "^0.8.8",
    "serialize-error": "^8.1.0",
    "sinon": "^15.2.0",
    "swagger-ui-dist": "^3.18.3-republish",
    "uuid": "^8.3.2",
    "winston": "^3.3.3",
    "xlsx": "^0.17.0",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "babel-eslint": "^10.1.0",
    "chai": "^4.3.4",
    "eslint": "^7.30.0",
    "eslint-config-airbnb-base": "^14.2.1",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-chai-expect": "^2.2.0",
    "eslint-plugin-import": "^2.23.4",
    "eslint-plugin-mocha": "^9.0.0",
    "eslint-plugin-prettier": "^3.4.0",
    "eslint-plugin-promise": "^5.1.0",
    "eslint-plugin-security": "^1.4.0",
    "eslint-plugin-you-dont-need-lodash-underscore": "^6.12.0",
    "faker": "^5.5.3",
    "husky": "^7.0.1",
    "lint-staged": "^11.0.1",
    "mocha": "^9.0.2",
    "nyc": "^15.1.0",
    "prettier": "^2.3.2",
    "prettier-cli": "^0.1.0",
    "randexp": "^0.5.3",
    "superagent": "^6.1.0",
    "supertest": "^6.1.3"
  }
}
